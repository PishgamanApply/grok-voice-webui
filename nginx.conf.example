# تنظیمات Nginx با پشتیبانی از SSL و WebSocket برای Grok Voice Agent
# مسیر پیشنهادی: /etc/nginx/sites-available/grok-voice.conf

server {
    listen 80;
    server_name your-domain.com www.your-domain.com;

    # ریدایرکت خودکار به HTTPS (میکروفون مرورگر حتما به HTTPS نیاز دارد)
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name your-domain.com www.your-domain.com;

    # مسیر گواهینامه‌های SSL (مثلا با Let's Encrypt Certbot)
    ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # پروکسی به برنامه Node.js روی پورت 3000
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # تنظیمات حیاتی برای ارتباط بلادرنگ WebSocket
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # جلوگیری از قطع خودکار وب‌سوکت در مکالمات طولانی
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # هدرهای شناسایی کلاینت
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
